<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tinyprobe.Cli</RootNamespace>
    <AssemblyName>tinyprobe</AssemblyName>
    <!-- Overridden by the release workflow with the version from the git tag. -->
    <Version>0.0.0-dev</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Native AOT size options, measured on linux-x64: 9.0 MB -> 8.0 MB (-11%), same behavior.
      Stack traces are never printed (reports show exception messages only), so dropping
      their method names is free. Do NOT add UseSystemResourceKeys: it saves ~30 KB but
      replaces encoding names with keys, and Spectre.Console then falls back to ASCII output.
    -->
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tinyprobe.Core\Tinyprobe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tinyprobe.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Printed by `tinyprobe guide`, so the guide always matches the installed version. -->
    <EmbeddedResource Include="..\..\docs\llm-guide.md" LogicalName="llm-guide.md" />
  </ItemGroup>

</Project>
