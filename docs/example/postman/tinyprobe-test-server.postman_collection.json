        {
          "name": "Signed echo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/echo?source=signed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "echo"
              ],
              "query": [
                {
                  "key": "source",
                  "value": "signed"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": 42\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const crypto = require(\"crypto-js\");",
                  "const body = pm.request.body.raw;",
                  "const signature = crypto.HmacSHA256(body, pm.environment.get(\"apiKey\")).toString(crypto.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Signature\", value: signature });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Signature sent\", () => pm.expect(pm.response.json().headers[\"X-Signature\"]).to.have.lengthOf(64));"
                ]
              }
            }
          ]
        },
