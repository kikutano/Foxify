# PARAMETRI PER SPEZZARE I LOOP E MIGLIORARE IL RAGIONAMENTO
# Aumenta la variabilità per uscire dai cicli di pensiero
PARAMETER temperature 0.75

# Penalizza le parole o strutture ripetute di recente
